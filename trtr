    local c1 = card(1, 34)
    label(c1, "Assist", UDim2.fromOffset(8, 0), UDim2.new(0.3, 0, 1, 0))
    local toggle = mkBtn(c1, "", UDim2.fromOffset(84, 22), UDim2.new(1, -90, 0.5, -11), ACCENT, 4)
    local function refreshToggle()
        toggle.Text = S.enabled and "assist: ON" or "assist: OFF"
        toggle.BackgroundColor3 = S.enabled and Color3.fromRGB(220, 20, 20) or Color3.fromRGB(90, 90, 90)
    end
    function stopMove()
        local ch = LocalPlayer.Character
        local hum = ch and ch:FindFirstChildOfClass("Humanoid")
        if hum then hum:Move(Vector3.new(0, 0, 0)) end
    end
    toggle.Activated:Connect(function()
        S.enabled = not S.enabled
        refreshToggle()
        if not S.enabled then stopMove() end
    end)
    refreshToggle()


    local function stepper(order, name, key, minV, maxV, step, suffix)
        local c = card(order, 34)
        local lbl = label(c, "", UDim2.fromOffset(8, 0), UDim2.new(0.5, 0, 1, 0))
        local minus = mkBtn(c, "-", UDim2.fromOffset(24, 22), UDim2.new(1, -88, 0.5, -11), ACCENT, 4)
        local plus = mkBtn(c, "+", UDim2.fromOffset(24, 22), UDim2.new(1, -32, 0.5, -11), ACCENT, 4)
        local val = Instance.new("TextBox")
        val.BackgroundColor3 = Color3.new(0, 0, 0)
        val.BackgroundTransparency = 0.45
        val.BorderSizePixel = 0
        val.ClearTextOnFocus = true
        val.Size = UDim2.fromOffset(32, 22)
        val.Position = UDim2.new(1, -62, 0.5, -11)
        val.TextColor3 = TEXT
        val.Font = Enum.Font.GothamBold
        val.TextSize = 11
        val.ZIndex = 4
        val.Parent = c
        local function refresh()
            lbl.Text = name
            val.Text = tostring(S[key]) .. suffix
        end
        val.FocusLost:Connect(function()
            local n = tonumber((val.Text:gsub("[^%d%.%-]", "")))
            if n then
                S[key] = math.clamp(math.floor(n + 0.5), minV, maxV)
            end
            refresh()
        end)
        local function change(d)
            S[key] = math.clamp(S[key] + d, minV, maxV)
            refresh()
        end
        local function hold(btn, d)
            btn.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    local active = true
                    local con
                    con = input.Changed:Connect(function()
                        if input.UserInputState == Enum.UserInputState.End then active = false; con:Disconnect() end
                    end)
                    change(d)
                    task.delay(0.4, function()
                        while active do change(d); task.wait(0.07) end
                    end)
                end
            end)
        end
        hold(minus, -step)
        hold(plus, step)
        refresh()
        return refresh
    end

    local rp = stepper(2, "Power", "power", 0, 100, 4, "%")
    local rr = stepper(3, "Range", "range", 1, 50, 1, "")

    local c4 = card(4, 28)
    local reset = mkBtn(c4, "Reset", UDim2.new(1, -12, 0, 20), UDim2.fromOffset(6, 4), Color3.fromRGB(170, 25, 25), 4)
    reset.TextSize = 11
    reset.Activated:Connect(function()
        S.enabled, S.power, S.range = false, 48, 10
        stopMove()
        refreshToggle(); rp(); rr()
    end)

    local hint = label(body, "by Eiden", UDim2.new(), UDim2.new(1, 0, 0, 12), Enum.TextXAlignment.Center)
    hint.LayoutOrder = 5
    hint.TextSize = 9
    hint.TextTransparency = 0.2

    local mini = Instance.new("ImageButton")
    mini.Size = UDim2.fromOffset(38, 38)
    mini.Position = UDim2.new(0, 10, 0.5, -19)
    mini.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
    mini.BackgroundTransparency = 0.2
    mini.Image = imgAsset or ""
    mini.ScaleType = Enum.ScaleType.Crop
    mini.AutoButtonColor = false
    mini.ZIndex = 20
    mini.Parent = gui
    local miniCorner = Instance.new("UICorner")
    miniCorner.CornerRadius = UDim.new(1, 0)
    miniCorner.Parent = mini
    local spinConn = RunService.RenderStepped:Connect(function(dt)
        mini.Rotation = (mini.Rotation + dt * 90) % 360
    end)

    local function setVisible(v)
        main.Visible = v
    end
    minBtn.Activated:Connect(function() setVisible(false) end)

    local mDrag, mStart, mPos, mMoved = false, nil, nil, false
    mini.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            mDrag, mStart, mPos, mMoved = true, input.Position, mini.Position, false
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    mDrag = false
                    if not mMoved then setVisible(not main.Visible) end
                end
            end)
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if mDrag and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local d = input.Position - mStart
            if d.Magnitude > 6 then mMoved = true end
            if mMoved then
                mini.Position = UDim2.new(mPos.X.Scale, mPos.X.Offset + d.X, mPos.Y.Scale, mPos.Y.Offset + d.Y)
            end
        end
    end)

    local keyConn = UIS.InputBegan:Connect(function(input, gp)
        if not gp and input.KeyCode == Enum.KeyCode.RightShift then
            setVisible(not main.Visible)
        end
    end)

    closeBtn.Activated:Connect(function()
        keyConn:Disconnect()
        spinConn:Disconnect()
        if mainConn then mainConn:Disconnect() end
        gui:Destroy()
    end)

    local dragging, dragStart, startPos
    for _, dragObj in ipairs({bar, main}) do dragObj.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging, dragStart, startPos = true, input.Position, main.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end) end
    UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local d = input.Position - dragStart
            main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
