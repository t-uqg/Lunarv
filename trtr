local AUDIO = ""

local function b64decode(str)
    local f = (crypt and (crypt.base64decode or crypt.base64_decode))
        or base64decode or base64_decode
        or (syn and syn.crypt and syn.crypt.base64 and syn.crypt.base64.decode)
        or (base64 and (base64.decode or base64.Decode))
    if f then
        local ok, r = pcall(f, str)
        if ok and r then return r end
    end
    local chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    local map = {}
    for i = 1, 64 do map[chars:byte(i)] = i - 1 end
    local out, n = {}, 0
    for i = 1, #str, 4 do
        local a, b, c, d = str:byte(i, i + 3)
        local v = (map[a] or 0) * 262144 + (map[b] or 0) * 4096 + (map[c] or 0) * 64 + (map[d] or 0)
        n = n + 1
        local x1, x2, x3 = math.floor(v / 65536), math.floor(v / 256) % 256, v % 256
        if c == 61 then out[n] = string.char(x1)
        elseif d == 61 then out[n] = string.char(x1, x2)
        else out[n] = string.char(x1, x2, x3) end
        if n % 20000 == 0 then task.wait() end
    end
    return table.concat(out)
end

local function prepareAssets()
    assert(writefile and isfile and getcustomasset, "unsupported executor")
    if makefolder and isfolder and not isfolder(DIR) then makefolder(DIR) end
    local images = {}
    for i, data in ipairs(FRAMES) do
        local path = string.format("%s/f%03d.jpg", DIR, i)
        if not isfile(path) then writefile(path, b64decode(data)) end
        images[i] = getcustomasset(path)
        if i % 40 == 0 then task.wait() end
    end
    local apath = DIR .. "/audio.mp3"
    if not isfile(apath) then writefile(apath, b64decode(AUDIO)) end
    return images, getcustomasset(apath)
end

local function playIntro(onFinish)
    local ok, images, audioAsset = pcall(prepareAssets)
    if not ok then
        warn("Intro skipped: " .. tostring(images))
        onFinish()
        return
    end

    local gui = Instance.new("ScreenGui")
    gui.Name = "IntroGui"
    gui.IgnoreGuiInset = true
    gui.ResetOnSpawn = false
    gui.DisplayOrder = 999999
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    local parent = (gethui and gethui()) or game:GetService("CoreGui")
    if not pcall(function() gui.Parent = parent end) then
        gui.Parent = LocalPlayer:WaitForChild("PlayerGui")
    end

    local bg = Instance.new("Frame")
    bg.Size = UDim2.fromScale(1, 1)
    bg.BackgroundColor3 = Color3.new(0, 0, 0)
    bg.BorderSizePixel = 0
    bg.Parent = gui

    local UIS = game:GetService("UserInputService")
    local isMobile = UIS.TouchEnabled and not UIS.KeyboardEnabled

    local labels = {}
    for i, id in ipairs(images) do
        local l = Instance.new("ImageLabel")
        l.AnchorPoint = Vector2.new(0.5, 0.5)
        l.Position = UDim2.fromScale(0.5, 0.5)
        l.Size = UDim2.fromScale(0.99, 0.99)
        l.BackgroundTransparency = 1
        l.Image = id
        l.ScaleType = Enum.ScaleType.Stretch
        l.ImageTransparency = 1
        l.Parent = bg
        labels[i] = l
    end
    local loaded = false
    task.spawn(function()
        pcall(function() game:GetService("ContentProvider"):PreloadAsync(labels) end)
        loaded = true
    end)

    local sound = Instance.new("Sound")
    sound.SoundId = audioAsset
    sound.Volume = 1
    sound.Parent = gui

    local skip = Instance.new("TextButton")
    skip.AnchorPoint = Vector2.new(1, 1)
    skip.Position = UDim2.new(1, -20, 1, -20)
    skip.Size = isMobile and UDim2.fromOffset(90, 32) or UDim2.fromOffset(110, 40)
    skip.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    skip.BackgroundTransparency = 0.2
    skip.TextColor3 = Color3.new(1, 1, 1)
    skip.Font = Enum.Font.GothamBold
    skip.TextSize = isMobile and 15 or 18
    skip.Text = "Skip"
    skip.ZIndex = 10
    skip.Parent = bg

    local done = false
    local conn
    local function finish()
        if done then return end
        done = true
        if conn then conn:Disconnect() end
        pcall(function() sound:Stop() end)
        gui:Destroy()
        onFinish()
    end
    skip.Activated:Connect(finish)

    local w0 = os.clock()
    while not loaded and not done and os.clock() - w0 < 10 do task.wait() end
    if done then return end

    sound:Play()
    local startT = os.clock()
    local total = #images / FPS
    local cur = 0
    conn = RunService.RenderStepped:Connect(function()
        local t = os.clock() - startT
        if t >= total then return finish() end
        local idx = math.clamp(math.floor(t * FPS) + 1, 1, #images)
        if idx ~= cur then
            if cur > 0 then labels[cur].ImageTransparency = 1 end
            labels[idx].ImageTransparency = 0
            cur = idx
        end
    end)
end

